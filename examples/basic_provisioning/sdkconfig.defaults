# basic_provisioning example sdkconfig.defaults
#
# Sensible defaults for a first-boot BLE provisioning product.
# All CONFIG_WIFI_* values match the wifi_manager Kconfig defaults.

# -----------------------------------------------------------------------
# WiFi manager
# -----------------------------------------------------------------------
CONFIG_WIFI_TASK_STACK_SIZE=6144
CONFIG_WIFI_SCAN_MAX_RESULTS=20
CONFIG_MAX_AP_COUNT=5
CONFIG_WIFI_KNOWN_AP_WAIT_MS=120000
CONFIG_WIFI_INTER_SCAN_DELAY_MS=3000
CONFIG_WIFI_CONNECT_TIMEOUT_MS=8000
CONFIG_WIFI_MAX_CONNECT_ATTEMPTS=3
CONFIG_WIFI_USE_COUNT_SAVE_INTERVAL=5
CONFIG_WIFI_SCAN_HIDDEN=n
CONFIG_WIFI_PROV_AUTH_MODE_MAC_POP=y
# Headless devices (no console for the operator to read a MAC-derived PoP
# from): use a fixed PoP known ahead of time instead. Uncomment these two
# lines and comment out the MAC_POP line above:
#   CONFIG_WIFI_PROV_AUTH_MODE_STATIC_POP=y
#   CONFIG_WIFI_PROV_POP="CHANGEME-1234"
#                          ^^^^^^^^ placeholder — pick your own value
#                          before flashing. If you skip this step and
#                          provisioning fails, this is almost certainly
#                          why: you typed a different PoP into the app
#                          than what's actually compiled into the device.
CONFIG_WIFI_PROV_TIMEOUT_MS=300000
CONFIG_WIFI_PROV_DEVICE_NAME_PREFIX="PROV_"
# BT controller lifecycle policy after a *successful* provisioning
# session. KEEP_ALIVE (default) leaves the BLE controller initialized,
# so the device can re-enter BLE provisioning later in the same boot
# (credential revocation, factory reset button) with no restart needed —
# costs ~20-30KB of heap for the rest of the boot. FREE_ON_SUCCESS
# recovers that heap but requires an automatic restart if BLE
# provisioning is ever needed again in the same boot (the component
# detects this and restarts itself; see WIFI_PROV_BT_LIFECYCLE help text
# in the component's Kconfig for the full rationale). KEEP_ALIVE is
# recommended unless you've confirmed you need the RAM back.
CONFIG_WIFI_PROV_BT_LIFECYCLE_KEEP_ALIVE=y
# CONFIG_WIFI_PROV_BT_LIFECYCLE_FREE_ON_SUCCESS=y
#
# Backoff before retrying a provisioning restart that fails synchronously
# (a rare guard path, not the normal timeout-driven retry — see
# WIFI_PROV_BLE_RETRY_BACKOFF_MS help text in the component's Kconfig).
# Deliberately separate from WIFI_INTER_SCAN_DELAY_MS above; left at the
# component default here.
CONFIG_WIFI_PROV_BLE_RETRY_BACKOFF_MS=2000

# -----------------------------------------------------------------------
# BLE / Bluetooth
# -----------------------------------------------------------------------
# NimBLE is selected explicitly. wifi_provisioning's BLE transport only
# needs BLE (not classic Bluetooth), and NimBLE's flash footprint is
# roughly half of Bluedroid's for this use case (~300KB vs ~650KB+ in
# real-world measurements) — the difference between fitting in the
# default 1MB factory partition and overflowing it.
#
# wifi_prov_scheme_ble works against either host; if your application
# also needs classic Bluetooth (BT_BLUEDROID + BT_CLASSIC_BT_ENABLED),
# switch CONFIG_BT_NIMBLE_ENABLED to n and CONFIG_BT_BLUEDROID_ENABLED to
# y instead, and budget extra partition space accordingly.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# -----------------------------------------------------------------------
# NVS
# -----------------------------------------------------------------------
CONFIG_NVS_ENCRYPTION=n

# -----------------------------------------------------------------------
# FreeRTOS
# -----------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
