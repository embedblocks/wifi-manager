# wifi_manager test_app sdkconfig.defaults
#
# These settings configure the test application for running Unity tests
# on real ESP32 hardware (or QEMU where supported). They are deliberately
# conservative — minimal stack, small scan buffers — to exercise the
# _Static_assert guards and keep flash usage low.

# -----------------------------------------------------------------------
# WiFi manager Kconfig
# -----------------------------------------------------------------------
CONFIG_WIFI_TASK_STACK_SIZE=5120
CONFIG_WIFI_SCAN_MAX_RESULTS=10
CONFIG_MAX_AP_COUNT=5
CONFIG_WIFI_KNOWN_AP_WAIT_MS=10000      # short for tests
CONFIG_WIFI_INTER_SCAN_DELAY_MS=500     # fast scan cycling during tests
CONFIG_WIFI_CONNECT_TIMEOUT_MS=4000
CONFIG_WIFI_MAX_CONNECT_ATTEMPTS=2
CONFIG_WIFI_USE_COUNT_SAVE_INTERVAL=1   # save every connection for tests
CONFIG_WIFI_SCAN_HIDDEN=n
CONFIG_WIFI_PROV_AUTH_MODE_MAC_POP=y
CONFIG_WIFI_PROV_TIMEOUT_MS=30000
CONFIG_WIFI_PROV_DEVICE_NAME_PREFIX="TEST_"

# -----------------------------------------------------------------------
# BLE / Bluetooth
# -----------------------------------------------------------------------
# wifi_manager unconditionally REQUIRES wifi_provisioning, which links a
# BT host stack regardless of whether tests exercise real BLE provisioning
# (the stubs in this test_app replace the WiFi driver, not the BT host).
# NimBLE keeps that footprint small; see examples/basic_provisioning's
# sdkconfig.defaults for the full rationale.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# -----------------------------------------------------------------------
# FreeRTOS
# -----------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000

# -----------------------------------------------------------------------
# NVS
# -----------------------------------------------------------------------
CONFIG_NVS_ENCRYPTION=n

# -----------------------------------------------------------------------
# Unity test runner
# -----------------------------------------------------------------------
CONFIG_UNITY_ENABLE_BACKTRACE_ON_FAIL=y
CONFIG_UNITY_ENABLE_IDF_TEST_RUNNER=y

# -----------------------------------------------------------------------
# Serial / logging
# -----------------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
